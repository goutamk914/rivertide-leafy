{
  "name": "@rivertide/app",
  "productName": "Rivertide",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Rivertide by Code the Cure: speak naturally, Rivertide writes clearly. Voice dictation, answers and a desktop assistant named Leafy.",
  "author": {
    "name": "Code the Cure",
    "url": "https://codethecure.org"
  },
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config vite.config.ts",
    "build:native": "bash scripts/build-native.sh",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build --config vite.config.ts",
    "fetch:wake-models": "node scripts/fetch-wake-models.mjs",
    "build": "npm run build:native && npm run fetch:wake-models && npm run build:renderer && npm run build:main",
    "start": "electron .",
    "dist": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "dist:adhoc": "npm run build && npm run pack:adhoc",
    "dist:signed": "npm run build && npm run pack:signed",
    "pack:adhoc": "electron-builder --config electron-builder.yml --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "pack:signed": "electron-builder --config electron-builder.yml --publish never -c.forceCodeSigning=true",
    "verify:mac": "bash scripts/verify-mac-build.sh",
    "publish:mac": "electron-builder publish --config electron-builder.yml --policy always --files release/*.dmg release/*.dmg.blockmap release/*.zip release/*.zip.blockmap release/latest-mac.yml",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@rivertide/island": "*",
    "@rivertide/leafy": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "d3-force": "^3.0.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unpdf": "^1.8.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
